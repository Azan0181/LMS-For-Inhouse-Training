@model VoyageFreightLMS.Models.ViewModels.ManageCheckpointsViewModel
@{
    ViewData["Title"] = $"Checkpoints - {Model.Video.Title}";
}

<div class="mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Index">Courses</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id">@Model.Course.Title</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Video.Title</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0">
                <i class="bi bi-patch-question-fill text-warning me-2"></i>Quiz Checkpoints & Questions
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateCheckpoint" asp-route-videoId="@Model.Video.Id" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Checkpoint
            </a>
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.Id" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Course
            </a>
        </div>
    </div>
</div>

<!-- Video Summary Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h5 class="fw-bold mb-1">@Model.Video.Title</h5>
                <p class="text-muted small mb-2">@(Model.Video.Description ?? "No description provided.")</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-secondary-subtle text-secondary border">
                        <i class="bi bi-sort-numeric-down me-1"></i>Order: Module #@(Model.Video.OrderIndex + 1)
                    </span>
                    <span class="badge bg-primary-subtle text-primary border">
                        <i class="bi bi-flag-fill me-1"></i>@Model.Checkpoints.Count Checkpoint(s)
                    </span>
                    <span class="badge bg-info-subtle text-dark border">
                        <i class="bi bi-question-circle-fill me-1"></i>@Model.Checkpoints.Sum(c => c.Questions.Count) Total Question(s)
                    </span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <span class="text-muted small d-block">Video URL</span>
                <code class="text-break small">@Model.Video.VideoUrl</code>
            </div>
        </div>
    </div>
</div>

<!-- Checkpoints List -->
@if (!Model.Checkpoints.Any())
{
    <div class="card border-0 shadow-sm rounded-4 text-center p-5">
        <div class="py-4">
            <i class="bi bi-stopwatch text-warning opacity-75" style="font-size: 3.5rem;"></i>
            <h5 class="fw-bold mt-3">No Checkpoints Configured Yet</h5>
            <p class="text-muted mx-auto" style="max-width: 480px;">
                Quiz checkpoints stop the video at a mandatory timestamp and present multiple-choice questions to the employee. Employees cannot advance without passing!
            </p>
            <a asp-action="CreateCheckpoint" asp-route-videoId="@Model.Video.Id" class="btn btn-primary shadow-sm px-4">
                <i class="bi bi-plus-circle me-1"></i> Create First Checkpoint
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var cp in Model.Checkpoints)
        {
            var minutes = cp.TimestampSeconds / 60;
            var seconds = cp.TimestampSeconds % 60;
            var timeFormatted = $"{minutes:D2}:{seconds:D2}";

            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6 rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-stopwatch me-1"></i> @timeFormatted (@cp.TimestampSeconds s)
                            </span>
                            <h5 class="fw-bold mb-0 ms-2">@cp.Title</h5>
                            <span class="badge bg-light text-muted border ms-2">
                                Passing: @cp.PassingScorePercent%
                            </span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a asp-action="CreateQuestion" asp-route-checkpointId="@cp.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Add Question
                            </a>
                            <form asp-action="DeleteCheckpoint" asp-route-id="@cp.Id" method="post" onsubmit="return confirm('Delete this checkpoint and all its questions?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Checkpoint">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        @if (!cp.Questions.Any())
                        {
                            <div class="alert alert-warning d-flex align-items-center justify-content-between mb-0" role="alert">
                                <div>
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>No questions added to this checkpoint!</strong> Add questions to make this checkpoint active.
                                </div>
                                <a asp-action="CreateQuestion" asp-route-checkpointId="@cp.Id" class="btn btn-sm btn-warning">
                                    <i class="bi bi-plus-circle me-1"></i> Add Question Now
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-uppercase">
                                        <tr>
                                            <th style="width: 50px;">#</th>
                                            <th>Question</th>
                                            <th>Answer Options</th>
                                            <th style="width: 100px;">Points</th>
                                            <th style="width: 80px;" class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var qList = cp.Questions.OrderBy(q => q.OrderIndex).ToList();
                                        }
                                        @for (int i = 0; i < qList.Count; i++)
                                        {
                                            var q = qList[i];
                                            <tr>
                                                <td class="fw-bold text-muted">@(i + 1)</td>
                                                <td class="fw-semibold">@q.QuestionText</td>
                                                <td>
                                                    <div class="d-flex flex-column gap-1">
                                                        @foreach (var opt in q.AnswerOptions.OrderBy(o => o.OrderIndex))
                                                        {
                                                            <div class="small d-flex align-items-center gap-2">
                                                                @if (opt.IsCorrect)
                                                                {
                                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                                        <i class="bi bi-check-circle-fill me-1"></i> @opt.OptionText
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">
                                                                        <i class="bi bi-circle me-1"></i> @opt.OptionText
                                                                    </span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@q.Points pt@(q.Points > 1 ? "s" : "")</span>
                                                </td>
                                                <td class="text-end">
                                                    <form asp-action="DeleteQuestion" asp-route-id="@q.Id" method="post" onsubmit="return confirm('Delete this question?');" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Question">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
