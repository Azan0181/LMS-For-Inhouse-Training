@using VoyageFreightLMS.Controllers
@model List<EmployeeReportListRow>
@{
    ViewData["Title"] = "Progress Reports";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-bar-chart-fill text-primary me-2"></i>Employee Progress Reports
        </h4>
        <p class="text-muted small mb-0">Select an employee to view their detailed training progress report</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people fs-1 d-block mb-3 opacity-50"></i>
        <h5 class="fw-bold">No Employees Found</h5>
        <p class="small">No employees have been added to the system yet.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var row in Model)
        {
            var pct = row.CompletionPercent;
            var barClass = pct >= 80 ? "bg-success" : pct >= 40 ? "bg-warning" : "bg-danger";

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:48px;height:48px;font-size:1.1rem;">
                                @row.Employee.FirstName.Substring(0, 1)@row.Employee.LastName.Substring(0, 1)
                            </div>
                            <div class="overflow-hidden">
                                <div class="fw-semibold text-truncate">@row.Employee.FullName</div>
                                <div class="small text-muted text-truncate">@row.Employee.Department &bull; @row.Employee.JobTitle</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Overall Completion</span>
                            <span class="fw-semibold text-dark">@pct%</span>
                        </div>
                        <div class="progress rounded-pill mb-3" style="height:8px;">
                            <div class="progress-bar @barClass rounded-pill" role="progressbar"
                                 style="width: @pct%;" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex gap-3 mb-4">
                            <div class="flex-fill text-center bg-light rounded-3 py-2">
                                <div class="fw-bold fs-5 text-primary">@row.TotalAssigned</div>
                                <div class="small text-muted">Assigned</div>
                            </div>
                            <div class="flex-fill text-center bg-light rounded-3 py-2">
                                <div class="fw-bold fs-5 text-success">@row.TotalCompleted</div>
                                <div class="small text-muted">Completed</div>
                            </div>
                            <div class="flex-fill text-center bg-light rounded-3 py-2">
                                <div class="fw-bold fs-5 text-warning">@(row.TotalAssigned - row.TotalCompleted)</div>
                                <div class="small text-muted">Pending</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Employee" asp-controller="Reports" asp-route-employeeId="@row.Employee.Id"
                               class="btn btn-primary flex-grow-1 rounded-3">
                                <i class="bi bi-graph-up me-1"></i>View Full Report
                            </a>
                            <a asp-action="DownloadPdf" asp-controller="Reports" asp-route-employeeId="@row.Employee.Id"
                               download
                               class="btn btn-outline-primary rounded-3 px-3"
                               title="Download PDF Report">
                                <i class="bi bi-file-earmark-arrow-down"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .hover-lift { transition: transform .2s, box-shadow .2s; }
    .hover-lift:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,.12) !important; }
</style>
