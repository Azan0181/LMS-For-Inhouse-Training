<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voyage Freight LMS</title>
    <meta name="description" content="Voyage Freight Technologies - Employee Learning Management System" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VoyageFreightLMS.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <!-- Sidebar -->
            <nav id="sidebar" class="sidebar bg-dark text-white">
                <div class="sidebar-header px-4 py-3 d-flex align-items-center justify-content-between">
                    <a class="navbar-brand text-white d-flex align-items-center text-decoration-none" asp-controller="Home" asp-action="Index">
                        <div class="brand-logo-badge me-2">
                            <img src="~/images/logo.png" alt="Voyage Freight" class="sidebar-logo-img" />
                        </div>
                        <span class="brand-badge">LMS</span>
                    </a>
                </div>
                <div class="sidebar-scrollable flex-grow-1">
                    <ul class="nav flex-column px-3 pt-2">
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link sidebar-link" asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-play-circle-fill me-2"></i> Courses & Modules
                            </a>
                        </li>
                        @if (User.IsInRole("Trainer") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-controller="Courses" asp-action="Create">
                                    <i class="bi bi-plus-circle-fill me-2"></i> Create Course
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item mt-3">
                                <span class="sidebar-section">Management</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-bar-chart-fill me-2"></i> Progress Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-controller="Assignments" asp-action="Index">
                                    <i class="bi bi-card-checklist me-2"></i> Assignments
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item mt-3">
                                <span class="sidebar-section">Administration</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-2"></i> Add Employee
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link sidebar-link" asp-controller="Account" asp-action="Users">
                                    <i class="bi bi-people-fill me-2"></i> User Directory
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="sidebar-footer mt-auto p-3 border-top border-dark-subtle">
                    <div class="user-pill d-flex align-items-center p-2 rounded-3">
                        <div class="avatar-circle me-2">
                            <span>@User.Identity?.Name?.Substring(0, 1).ToUpper()</span>
                        </div>
                        <div class="flex-grow-1 text-truncate pe-2">
                            <span class="user-name text-truncate d-block fw-semibold text-white small">@User.Identity?.Name</span>
                            <small class="user-role d-block text-muted" style="font-size: 0.72rem;">Active Session</small>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-icon-logout" title="Sign Out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </nav>
        }

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1 @(User.Identity?.IsAuthenticated == true ? "" : "auth-page-wrapper")">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <header class="navbar navbar-expand px-4 py-3 topbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-light border-0 shadow-none p-2 rounded-3" id="sidebarToggle" title="Toggle Navigation">
                            <i class="bi bi-text-indent-left fs-5 text-secondary"></i>
                        </button>
                        <div class="topbar-title-wrap">
                            <span class="text-xs text-muted text-uppercase fw-semibold tracking-wider">Voyage Portal</span>
                            <h6 class="mb-0 fw-bold text-dark">@ViewData["Title"]</h6>
                        </div>
                    </div>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold small">
                            <i class="bi bi-shield-check me-1"></i> Compliance LMS
                        </span>
                    </div>
                </header>

                <div class="container-fluid p-4">
                    <!-- Toast notifications -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            }
            else
            {
                <!-- Toast notifications for auth pages -->
                @if (TempData["Success"] != null)
                {
                    <div class="position-fixed top-0 start-50 translate-middle-x mt-3 z-3 alert alert-success alert-dismissible fade show shadow-lg" role="alert">
                        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="position-fixed top-0 start-50 translate-middle-x mt-3 z-3 alert alert-danger alert-dismissible fade show shadow-lg" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <main role="main" class="auth-main">
                    @RenderBody()
                </main>
            }
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
