@model VoyageFreightLMS.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = $"Edit User - {Model.FirstName} {Model.LastName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Users" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to All Users
                </a>
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-person-gear text-primary me-2"></i>Edit User Account & Credentials
                </h4>
            </div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="bi bi-shield-lock-fill me-1"></i> Admin Only
            </span>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="bg-primary-subtle text-primary-emphasis p-3 rounded-3 mb-4 d-flex align-items-start gap-3 border border-primary-subtle">
                    <i class="bi bi-shield-check fs-4 mt-1"></i>
                    <div class="small">
                        <strong class="d-block mb-1">Administrative Privilege Access</strong>
                        Only administrators have permission to update employee profiles, change role permissions, or reset login credentials.
                    </div>
                </div>

                <form asp-action="EditUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <!-- Personal Information -->
                    <h6 class="fw-bold text-muted text-uppercase small mb-3 tracking-wide">
                        <i class="bi bi-person-lines-fill me-1"></i> Personal Profile
                    </h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
                            <input asp-for="FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
                            <input asp-for="LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email & Login Username <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@voyagefreight.com" />
                        </div>
                        <div class="form-text small">This is the email address used to sign in to the LMS.</div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Logistics, Safety, IT" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobTitle" class="form-label fw-semibold">Job Title</label>
                            <input asp-for="JobTitle" class="form-control" placeholder="e.g. Dispatcher, Driver, Fleet Mgr" />
                            <span asp-validation-for="JobTitle" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Role & Permissions -->
                    <h6 class="fw-bold text-muted text-uppercase small mb-3 tracking-wide">
                        <i class="bi bi-person-badge me-1"></i> Role & Access Level
                    </h6>

                    <div class="mb-4">
                        <label asp-for="Role" class="form-label fw-semibold">Assigned Role <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Employee">Employee (Watches assigned training & completes quiz checkpoints)</option>
                            <option value="Trainer">Trainer (Creates courses, uploads videos & configures quizzes)</option>
                            <option value="HR">HR (Enrolls staff & audits compliance)</option>
                            <option value="Manager">Manager (Monitors team training performance)</option>
                            <option value="Admin">Admin (Full administrative & system control)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Password Reset Section -->
                    <h6 class="fw-bold text-muted text-uppercase small mb-3 tracking-wide">
                        <i class="bi bi-key me-1"></i> Reset Password (Optional)
                    </h6>

                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="small text-muted mb-3">
                            <i class="bi bi-info-circle me-1"></i> Leave these fields <strong>blank</strong> if you do not want to change the user's current password.
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min. 6 characters" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Confirm New Password</label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Re-type password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Users" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
