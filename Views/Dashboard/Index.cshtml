@model VoyageFreightLMS.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Executive LMS Reports";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-graph-up-arrow text-primary me-2"></i>Executive LMS Reports & Compliance
        </h4>
        <p class="text-muted small mb-0">Live analytics on employee completion, scores, and training progress</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Assignments" asp-action="Create" class="btn btn-primary shadow-sm btn-sm px-3">
            <i class="bi bi-plus-circle me-1"></i> New Assignment
        </a>
    </div>
</div>

<!-- Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="rounded-4 bg-primary-subtle text-primary p-3 me-3">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Employees</span>
                    <h3 class="fw-bold mb-0">@Model.TotalEmployees</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="rounded-4 bg-info-subtle text-info p-3 me-3">
                    <i class="bi bi-collection-play-fill fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Published Courses</span>
                    <h3 class="fw-bold mb-0">@Model.TotalCourses</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="rounded-4 bg-warning-subtle text-warning-emphasis p-3 me-3">
                    <i class="bi bi-clipboard-data-fill fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Assignments</span>
                    <h3 class="fw-bold mb-0">@Model.TotalAssignments</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex align-items-center">
                <div class="rounded-4 bg-success-subtle text-success p-3 me-3">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Completion Rate</span>
                    <h3 class="fw-bold mb-0">@Model.OverallCompletionRate%</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Employee Performance Table -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0">Employee Training Compliance</h5>
                <span class="badge bg-light text-muted border">@Model.Employees.Count Employee(s)</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Employees.Any())
                {
                    <div class="text-center py-5 text-muted small">No employee records found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-4">Employee</th>
                                    <th>Assigned</th>
                                    <th>Finished</th>
                                    <th style="width: 140px;">Completion</th>
                                    <th class="text-end pe-4">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var emp in Model.Employees)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-semibold">@emp.Employee.FullName</div>
                                            <div class="small text-muted">@emp.Employee.Department &bull; @emp.Employee.JobTitle</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@emp.AssignedCourses</span></td>
                                        <td><span class="badge bg-success-subtle text-success border">@emp.CompletedCourses</span></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                    <div class="progress-bar @(emp.CompletionRate == 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @emp.CompletionRate%;"></div>
                                                </div>
                                                <span class="small fw-semibold">@emp.CompletionRate%</span>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-action="EmployeeDetail" asp-route-id="@emp.Employee.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Course Adoption Table -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0">Course Enrollment Stats</h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Courses.Any())
                {
                    <div class="text-center py-5 text-muted small">No courses published yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th class="ps-4">Course</th>
                                    <th>Enrolled</th>
                                    <th class="text-end pe-4">Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Courses)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Course.Id" class="fw-semibold text-dark text-decoration-none">
                                                @c.Course.Title
                                            </a>
                                            <div class="small text-muted">@c.Course.Category</div>
                                        </td>
                                        <td>
                                            <span class="small text-muted">@c.CompletedCount / @c.TotalAssignments</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="badge @(c.CompletionRate >= 80 ? "bg-success" : "bg-primary") rounded-pill">
                                                @c.CompletionRate%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Enrollments -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom py-3 px-4">
        <h5 class="fw-bold mb-0">Recent Course Enrollments</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.RecentAssignments.Any())
        {
            <div class="text-center py-4 text-muted small">No recent activity.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th class="ps-4">Employee</th>
                            <th>Course</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.RecentAssignments)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@a.Employee?.FullName</td>
                                <td>@a.Course?.Title</td>
                                <td class="small text-muted">@a.AssignedAt.ToString("g")</td>
                                <td class="text-end pe-4">
                                    <span class="badge @(a.Status == VoyageFreightLMS.Models.AssignmentStatus.Completed ? "bg-success" : (a.Status == VoyageFreightLMS.Models.AssignmentStatus.InProgress ? "bg-warning text-dark" : "bg-secondary")) rounded-pill">
                                        @a.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
