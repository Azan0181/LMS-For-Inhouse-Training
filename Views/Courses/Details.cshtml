@model CourseDetailsViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    bool isTrainer = ViewBag.IsTrainer;
}

<div class="row">
    <!-- Course Info -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            @if (!string.IsNullOrEmpty(Model.Course.ThumbnailUrl))
            {
                <img src="@Model.Course.ThumbnailUrl" class="card-img-top" style="height:250px;object-fit:cover;" alt="@Model.Course.Title" />
            }
            else
            {
                <div class="card-img-top d-flex align-items-center justify-content-center" style="height:250px;background:linear-gradient(135deg,#667eea,#764ba2);">
                    <i class="bi bi-collection-play text-white" style="font-size:4rem;"></i>
                </div>
            }
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h4 class="fw-bold mb-0">@Model.Course.Title</h4>
                    @if (isTrainer)
                    {
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.Course.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <form asp-action="TogglePublish" asp-route-id="@Model.Course.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(Model.Course.IsPublished ? "btn-outline-warning" : "btn-outline-success")">
                                    <i class="bi @(Model.Course.IsPublished ? "bi-eye-slash" : "bi-broadcast") me-1"></i>
                                    @(Model.Course.IsPublished ? "Unpublish" : "Publish")
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mb-3">
                    @if (!string.IsNullOrEmpty(Model.Course.Category))
                    {
                        <span class="badge bg-light text-dark"><i class="bi bi-tag me-1"></i>@Model.Course.Category</span>
                    }
                    <span class="badge bg-light text-dark"><i class="bi bi-signal me-1"></i>@Model.Course.DifficultyLevel</span>
                    <span class="badge bg-light text-dark"><i class="bi bi-clock me-1"></i>@Model.Course.EstimatedDurationMinutes min</span>
                </div>
                <p>@Model.Course.Description</p>
                <small class="text-muted">Created by @Model.Course.CreatedBy.FullName · @Model.Course.CreatedAt.ToString("MMM dd, yyyy")</small>
            </div>
        </div>

        <!-- Videos List -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-film me-2"></i>Videos (@Model.Videos.Count)</h6>
                @if (isTrainer)
                {
                    <a asp-controller="Videos" asp-action="Create" asp-route-courseId="@Model.Course.Id" class="btn btn-sm btn-primary">
                        <i class="bi bi-upload me-1"></i>Upload Video
                    </a>
                }
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.Videos.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-film" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0">No videos yet. @(isTrainer ? "Upload the first one!" : "")</p>
                    </div>
                }
                @foreach (var video in Model.Videos)
                {
                    Model.VideoProgressMap.TryGetValue(video.Id, out var progress);
                    var isCompleted = progress?.IsCompleted == true;

                    <div class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <div class="me-3">
                            @if (isCompleted)
                            {
                                <div class="avatar-circle bg-success text-white"><i class="bi bi-check-lg"></i></div>
                            }
                            else
                            {
                                <div class="avatar-circle bg-light text-muted"><span>@(video.OrderIndex + 1)</span></div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="mb-0 fw-semibold">@video.Title</h6>
                            <small class="text-muted">@video.Checkpoints.Count checkpoint(s)</small>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            @if (Model.Assignment != null)
                            {
                                <a asp-controller="Player" asp-action="Watch"
                                   asp-route-videoId="@video.Id" asp-route-assignmentId="@Model.Assignment.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-play-fill me-1"></i>@(isCompleted ? "Rewatch" : progress != null ? "Resume" : "Watch")
                                </a>
                            }
                            @if (isTrainer)
                            {
                                <a asp-controller="Checkpoints" asp-action="Manage" asp-route-videoId="@video.Id"
                                   class="btn btn-sm btn-outline-secondary" title="Manage checkpoints">
                                    <i class="bi bi-list-check"></i>
                                </a>
                                <a asp-controller="Videos" asp-action="Edit" asp-route-id="@video.Id"
                                   class="btn btn-sm btn-outline-secondary" title="Edit video">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-controller="Videos" asp-action="Delete" asp-route-id="@video.Id" method="post"
                                      class="d-inline" onsubmit="return confirm('Delete this video?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete video">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (isTrainer)
        {
            <!-- Enrolled Employees & Completion Breakdown -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-people-fill text-primary me-2"></i>Enrolled Employees & Completion Status (@Model.EnrolledAssignments.Count)
                    </h6>
                    <a asp-controller="Assignments" asp-action="Create" asp-route-courseId="@Model.Course.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-person-plus me-1"></i> Enroll Employees
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.EnrolledAssignments.Any())
                    {
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-clipboard-x fs-3 d-block mb-2 text-secondary"></i>
                            No employees currently enrolled in this course.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-uppercase">
                                    <tr>
                                        <th class="ps-3">Employee</th>
                                        <th>Modules Done</th>
                                        <th style="width: 140px;">Progress</th>
                                        <th>Status</th>
                                        <th class="text-end pe-3">Record</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assign in Model.EnrolledAssignments)
                                    {
                                        var compVids = assign.VideoProgresses.Count(vp => vp.IsCompleted);
                                        var totVids = Model.Videos.Count;
                                        var pct = totVids > 0 ? Math.Round((double)compVids / totVids * 100, 0) : 0;

                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-semibold">@assign.Employee?.FullName</div>
                                                <div class="small text-muted">@assign.Employee?.Department &bull; @assign.Employee?.Email</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @compVids / @totVids
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar @(assign.Status == AssignmentStatus.Completed ? "bg-success" : "bg-primary")" role="progressbar" style="width: @pct%;"></div>
                                                    </div>
                                                    <span class="small fw-semibold">@pct%</span>
                                                </div>
                                            </td>
                                            <td>
                                                @switch (assign.Status)
                                                {
                                                    case AssignmentStatus.Completed:
                                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                            <i class="bi bi-check-circle-fill me-1"></i> Completed
                                                        </span>
                                                        break;
                                                    case AssignmentStatus.InProgress:
                                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                            <i class="bi bi-play-circle-fill me-1"></i> In Progress
                                                        </span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                                            <i class="bi bi-hourglass me-1"></i> Not Started
                                                        </span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="Dashboard" asp-action="EmployeeDetail" asp-route-id="@assign.EmployeeId" class="btn btn-sm btn-outline-secondary" title="View Employee File">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        @if (Model.Assignment != null)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body text-center">
                    <h6 class="fw-bold">Your Progress</h6>
                    <div class="position-relative d-inline-block my-3">
                        <svg width="120" height="120" viewBox="0 0 120 120">
                            <circle cx="60" cy="60" r="50" fill="none" stroke="#e9ecef" stroke-width="10" />
                            <circle cx="60" cy="60" r="50" fill="none" stroke="#0d6efd" stroke-width="10"
                                    stroke-dasharray="@(Math.Round(Model.OverallProgressPercent * 3.14, 0)) 314"
                                    stroke-linecap="round" transform="rotate(-90 60 60)" />
                        </svg>
                        <div class="position-absolute top-50 start-50 translate-middle">
                            <span class="fw-bold fs-5">@Model.OverallProgressPercent%</span>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">@Model.CompletedVideos of @Model.TotalVideos videos completed</p>
                    <span class="badge mt-2 @(Model.Assignment.Status == AssignmentStatus.Completed ? "bg-success" : Model.Assignment.Status == AssignmentStatus.InProgress ? "bg-primary" : "bg-secondary")">
                        @Model.Assignment.Status
                    </span>
                </div>
            </div>
        }

        @if (isTrainer)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-info-circle me-2"></i>Course Stats</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="bi bi-people me-2 text-muted"></i>@Model.Course.Assignments.Count assignment(s)</li>
                        <li class="mb-2"><i class="bi bi-film me-2 text-muted"></i>@Model.Videos.Count video(s)</li>
                        <li class="mb-2">
                            <i class="bi bi-broadcast me-2 text-muted"></i>
                            @(Model.Course.IsPublished ? "Published" : "Draft")
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold text-danger"><i class="bi bi-trash me-2"></i>Danger Zone</h6>
                    <form asp-action="Delete" asp-route-id="@Model.Course.Id" method="post"
                          onsubmit="return confirm('Are you sure? This will delete the course and all its videos, checkpoints, and questions.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Delete Course</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
