@model VoyageFreightLMS.Models.ViewModels.VideoUploadViewModel
@{
    ViewData["Title"] = "Upload Video Module";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Course
                </a>
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-cloud-arrow-up-fill text-primary me-2"></i>Upload Video Module
                </h4>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                <i class="bi bi-film me-1"></i> Course #@Model.CourseId
            </span>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="bg-light p-3 rounded-3 mb-4 d-flex align-items-start gap-3 border">
                    <i class="bi bi-info-circle-fill text-primary fs-4 mt-1"></i>
                    <div class="small text-muted">
                        <strong class="text-dark d-block mb-1">Interactive Video Checkpoints Note</strong>
                        Once uploaded, you'll be able to attach mandatory multiple-choice quiz checkpoints to specific timestamps in this video.
                    </div>
                </div>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CourseId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Video Title <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-type"></i></span>
                            <input asp-for="Title" class="form-control border-start-0" placeholder="e.g. Module 1: Cargo Safety & Hazmat Handling" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Outline the key learning objectives covered in this video module..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="VideoFile" class="form-label fw-semibold">Video File <span class="text-danger">*</span></label>
                            <input asp-for="VideoFile" type="file" class="form-control" accept="video/mp4,video/webm,video/ogg,video/quicktime" />
                            <div class="form-text small">Accepted formats: MP4, WebM, QuickTime (H.264 recommended)</div>
                            <span asp-validation-for="VideoFile" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Sequence Order</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-sort-numeric-down"></i></span>
                                <input asp-for="OrderIndex" type="number" class="form-control border-start-0" min="0" />
                            </div>
                            <div class="form-text small">Playback position</div>
                            <span asp-validation-for="OrderIndex" class="text-danger small"></span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="DurationSeconds" id="videoDurationSeconds" />

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-upload me-1"></i> Upload Module
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('input[name="VideoFile"]')?.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const tempVideo = document.createElement('video');
                tempVideo.preload = 'metadata';
                tempVideo.onloadedmetadata = function () {
                    window.URL.revokeObjectURL(tempVideo.src);
                    const duration = Math.round(tempVideo.duration || 0);
                    if (duration > 0) {
                        document.getElementById('videoDurationSeconds').value = duration;
                    }
                };
                tempVideo.src = URL.createObjectURL(file);
            }
        });
    </script>
}
